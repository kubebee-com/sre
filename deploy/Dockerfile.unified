# syntax=docker/dockerfile:1
ARG GO_IMAGE=golang:1.26.11-alpine@sha256:ecb67f987aa1a57794c91d19ade7ae0209f2f0f5496aaef9e6ae85ddf92d02ab
ARG RUNTIME_IMAGE=cgr.dev/chainguard/static@sha256:fc42af33e643f20d08baf03cddcc1c02ba57052dfb02edb0d79f3fc47bcea8d9
ARG VERSION=dev
ARG REVISION=unknown
ARG BUILD_DATE=unknown
FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS build-base
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

FROM build-base AS build-agent
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -p 1 -trimpath \
    -ldflags="-s -w -X github.com/kubebee-com/sre/pkg/buildinfo.Version=${VERSION} -X github.com/kubebee-com/sre/pkg/buildinfo.Revision=${REVISION} -X github.com/kubebee-com/sre/pkg/buildinfo.BuildDate=${BUILD_DATE}" \
    -o /out/sre-agent ./cmd/sre-agent

FROM build-base AS build-orchestrator
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -p 1 -trimpath \
    -ldflags="-s -w -X github.com/kubebee-com/sre/pkg/buildinfo.Version=${VERSION} -X github.com/kubebee-com/sre/pkg/buildinfo.Revision=${REVISION} -X github.com/kubebee-com/sre/pkg/buildinfo.BuildDate=${BUILD_DATE}" \
    -o /out/sre-orchestrator ./cmd/sre-orchestrator
FROM ${RUNTIME_IMAGE} AS orchestrator
ARG VERSION=dev
ARG REVISION=unknown
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.title="KubeBee SRE Orchestrator" \
      org.opencontainers.image.description="HA scoped SRE orchestration, approvals, notifications and audit" \
      org.opencontainers.image.source="https://github.com/kubebee-com/sre" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.licenses="Apache-2.0"
USER 65532:65532
COPY --from=build-orchestrator /out/sre-orchestrator /usr/local/bin/sre-orchestrator
ENTRYPOINT ["/usr/local/bin/sre-orchestrator"]
FROM ${RUNTIME_IMAGE} AS agent
ARG VERSION=dev
ARG REVISION=unknown
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.title="KubeBee SRE Agent" \
      org.opencontainers.image.description="Authenticated Kubernetes collection, diagnosis and approval-gated execution" \
      org.opencontainers.image.source="https://github.com/kubebee-com/sre" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.licenses="Apache-2.0"
USER 65532:65532
COPY --from=build-agent /out/sre-agent /usr/local/bin/sre-agent
ENTRYPOINT ["/usr/local/bin/sre-agent", "--managed"]
