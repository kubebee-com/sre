# syntax=docker/dockerfile:1
# Sandboxed AI Agent Runner Image for Kubebee SRE
# Runs inside ephemeral Kubernetes Jobs isolated by gVisor (runtimeClassName: gvisor)
# or Kata Containers (runtimeClassName: kata) on KVM-capable nodes.
ARG NODE_IMAGE=node:22-bookworm-slim
ARG TARGETARCH
FROM ${NODE_IMAGE}

ARG TARGETARCH
ARG KUBECTL_VERSION=v1.35.0
ARG CODEX_VERSION=latest

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      git \
      jq \
      openssh-client \
    && rm -rf /var/lib/apt/lists/*

# Install kubectl for cluster inspection (Phase 1 RO) and approved remediation (Phase 2).
RUN curl -fsSL "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${TARGETARCH:-amd64}/kubectl" \
      -o /usr/local/bin/kubectl \
    && chmod 0755 /usr/local/bin/kubectl

# Install OpenAI Codex CLI (default Kubebee agent harness).
RUN npm install -g "@openai/codex@${CODEX_VERSION}" \
    && npm cache clean --force

# Optional: mount or bake `agy` binary into /usr/local/bin/agy for agy harness mode.
RUN groupadd -g 10001 sre && useradd -u 10001 -g 10001 -m -d /workspace -s /bin/sh sre \
    && mkdir -p /workspace /tmp \
    && chown 10001:10001 /workspace /tmp

USER 10001:10001
WORKDIR /workspace
ENTRYPOINT ["/bin/sh", "-c"]
